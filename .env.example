# Environment configuration (optional)
# Copy to .env and customize

# Face Detection
FACE_DETECTION_CONFIDENCE=0.5
FACE_DETECTION_MODEL=short_range

# Image Processing
DEFAULT_OUTPUT_SIZE=520
DEFAULT_MARGIN=0.75
DEFAULT_UPWARD_BIAS=0.10

# Grid Layout
DEFAULT_COLUMNS=4
DEFAULT_PADDING=40
DEFAULT_LABEL_HEIGHT=80
DEFAULT_FONT_SIZE=46
DEFAULT_BACKGROUND_COLOR=#ffffff

# Performance
MAX_WORKERS=4
MAX_FILE_SIZE_MB=50
